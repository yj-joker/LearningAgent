# MySQL
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

#JWT
# 使用 32 字节以上的随机数据生成 Base64 字符串，不要填写普通短密码。
JWT_SECRET=
JWT_EXPIRATION_MILLIS=

# Snowflake（0~1023，多实例部署时每个实例必须不同）
SNOWFLAKE_WORKER_ID=0

#Aliyun
ALIYUN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
ALIYUN_EMBEDDING_API_KEY=
ALIYUN_EMBEDDING_MODEL=qwen3.7-text-embedding
ALIYUN_EMBEDDING_DIMENSIONS=1536
ALIYUN_EMBEDDING_MAX_BATCH_SIZE=20
ALIYUN_EMBEDDING_MAX_CONCURRENCY=2
ALIYUN_EMBEDDING_ACQUIRE_TIMEOUT_SECONDS=30
ALIYUN_EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
ALIYUN_EMBEDDING_READ_TIMEOUT_SECONDS=60


#Milvus
MILVUS_HOST=
MILVUS_PORT=19530
