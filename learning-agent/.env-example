# MySQL：本机 Java 通过映射端口连接 Docker MySQL。
# 当前中间件 Compose 使用 root；MYSQL_PASSWORD 同时用于初始化容器 root 密码。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=learning_agent
MYSQL_USER=root
MYSQL_PASSWORD=

#JWT
# 使用 32 字节以上的随机数据生成 Base64 字符串，不要填写普通短密码。
JWT_SECRET=
JWT_EXPIRATION_MILLIS=360000

# MinIO：账号密码同时供 Java、MinIO 容器和 Milvus 使用。
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=document-bucket
# 若修改 API 映射端口，MINIO_ENDPOINT 的端口也必须同步修改。
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Snowflake（0~1023，多实例部署时每个实例必须不同）
SNOWFLAKE_WORKER_ID=0

#Aliyun
ALIYUN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
ALIYUN_EMBEDDING_API_KEY=
ALIYUN_EMBEDDING_MODEL=qwen3.7-text-embedding
ALIYUN_EMBEDDING_DIMENSIONS=1536
ALIYUN_EMBEDDING_MAX_BATCH_SIZE=20
ALIYUN_EMBEDDING_MAX_CONCURRENCY=2
ALIYUN_EMBEDDING_ACQUIRE_TIMEOUT_SECONDS=30
ALIYUN_EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
ALIYUN_EMBEDDING_READ_TIMEOUT_SECONDS=60


#Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
ATTU_PORT=8000
