<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yjjoker.learningagent.repository.UserRepository">

    <!-- count 和明细查询复用同一组条件，避免两条 SQL 的筛选规则不一致。 -->
    <sql id="userConditions">
        <where>
            <if test="condition.username != null and condition.username != ''">
                and username like concat('%', #{condition.username}, '%')
            </if>
            <if test="condition.role != null">
                and role = #{condition.role}
            </if>
            <if test="condition.createdAtStart != null">
                and created_at &gt;= #{condition.createdAtStart}
            </if>
            <if test="condition.createdAtEnd != null">
                and created_at &lt;= #{condition.createdAtEnd}
            </if>
        </where>
    </sql>

    <select id="countByCondition" resultType="long">
        select count(*)
        from `user`
        <include refid="userConditions"/>
    </select>

    <select id="findPageByCondition"
            resultType="com.yjjoker.learningagent.entity.User">
        select id,
               username,
               role,
               avatar_url as avatarUrl,
               created_at as createdAt,
               updated_at as updatedAt
        from `user`
        <include refid="userConditions"/>
        order by id desc
        limit #{limit} offset #{offset}
    </select>

</mapper>
